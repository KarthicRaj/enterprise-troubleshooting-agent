# GitHub Enterprise / GitHub Enterprise Cloud
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# Atlassian Confluence Cloud
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Application
APP_ENV=local
LOG_LEVEL=INFO

GITHUB_ALLOWED_REPOSITORIES=https://github.com/KarthicRaj/commerce
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest


# Splunk connection
SPLUNK_BASE_URL=
SPLUNK_TOKEN=
SPLUNK_INDEXES=
SPLUNK_SOURCETYPES=
SPLUNK_VERIFY_TLS=true
SPLUNK_MAX_RESULTS=100
SPLUNK_LOOKBACK_MINUTES=60